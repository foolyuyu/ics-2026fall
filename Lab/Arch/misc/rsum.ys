# [redacted] [redacted]
    .pos 0
    irmovq stack, %rsp
    call main
    halt

    .align 8
ele1:
    .quad 0x00d
    .quad ele2
ele2:
    .quad 0x0e0
    .quad ele3
ele3:
    .quad 0xf00
    .quad 0



rsum_list:
    andq %rdi, %rdi
    je L1                #如果是null的话，直接返回0
    pushq %rbx
    mrmovq (%rdi), %rbx
    mrmovq 8(%rdi), %rdi #找到ls->next并放进rdi里面作为调用rsum_list的参数
    call rsum_list
    addq %rbx, %rax
    popq %rbx
    ret
L1:
    irmovq $0, %rax
    ret

main:
    irmovq ele1, %rdi
    call rsum_list
    ret

.pos 0x200
stack:
